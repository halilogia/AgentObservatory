{
  "name": "agent-observatory",
  "version": "1.0.0-alpha",
  "description": "Event-First Hybrid AI Agent Management and Observability System",
  "main": "src/index.js",
  "bin": {
    "observatory": "bin/observatory.js"
  },
  "scripts": {
    "start": "node bin/observatory.js",
    "watch": "node bin/observatory.js watch",
    "mcp": "node bin/observatory.js mcp",
    "typecheck": "tsc --noEmit",
    "test": "node --experimental-strip-types test/verify_core.ts && node --experimental-strip-types test/verify_live_cancel.ts",
    "check": "npm run typecheck && npm run test"
  },
  "keywords": [
    "ai",
    "agent",
    "observability",
    "claude-code",
    "codex",
    "antigravity",
    "mcp",
    "telemetry"
  ],
  "author": "Halil Emre",
  "license": "GPL-3.0-or-later",
  "type": "module",
  "devDependencies": {
    "@types/node": "^26.6.5",
    "typescript": "^7.0.2"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.32.1",
    "zod": "^4.6.5"
  }
}
